# Requirements Studio configuration. Copy to .env for local development. Every setting is RS_*.
# Values below match docker-compose.yml and are for local development only.

# dev | test | prod.
RS_ENV=dev

# Postgres 16 + pgvector (async driver)
RS_DATABASE_URL=postgresql+asyncpg://rs:rs@localhost:5432/rs

# Redis: arq job queue and the event stream
RS_REDIS_URL=redis://localhost:6379/0

# Sign-in. Accounts are internal (roles user | admin); create the first admin with tools/create_admin.py.
# RS_ENV=dev|test also offers a "sign in as" picker and POST /dev/token (never in prod).
RS_PASSWORD_SIGN_IN=true
# Signs session tokens. Required in prod: 32+ random characters (openssl rand -base64 48).
RS_SESSION_SECRET=
RS_SESSION_TTL_MINUTES=480
# The web app's address, used in email links (invitations, password resets, approvals).
RS_WEB_BASE_URL=http://localhost:5173
# Public base URL of the API
RS_PUBLIC_BASE_URL=http://localhost:8000

# Optional Microsoft Entra ID SSO: none | entra. Only people an admin has added can sign in (matched by email).
# Two app registrations in your tenant (see README "Microsoft Entra ID SSO"): the API (expose scope
# access_as_user, manifest accessTokenAcceptedVersion: 2) and the web app (single-page application, redirect URI
# <web origin>/, API permission on access_as_user). RS_PASSWORD_SIGN_IN=false makes it SSO only.
RS_SSO=none
RS_ENTRA_TENANT_ID=
RS_ENTRA_API_CLIENT_ID=
RS_ENTRA_SPA_CLIENT_ID=
# Defaults to api://<RS_ENTRA_API_CLIENT_ID>/access_as_user
# RS_ENTRA_API_SCOPE=

# Email: invitations, password resets and approval requests, sent over SMTP. Locally, Mailpit from
# docker-compose.yml catches everything (http://localhost:8025). Office 365: smtp.office365.com, port 587, starttls.
# RS_EMAIL_BACKEND=console logs emails instead of sending them.
RS_EMAIL_BACKEND=smtp
# Which process sends queued email: api | worker | off
RS_EMAIL_SENDER=api
RS_EMAIL_FROM=Requirements Studio <no-reply@requirements-studio.local>
RS_SMTP_HOST=localhost
RS_SMTP_PORT=1025
RS_SMTP_USERNAME=
RS_SMTP_PASSWORD=
# none | starttls | tls
RS_SMTP_SECURITY=none

# Object storage for export packages (and, later, uploaded sources): fs or azure_blob.
# Production: RS_AZURE_STORAGE_ACCOUNT_URL with the app's managed identity (role "Storage Blob Data Contributor").
# Local: Azurite from docker-compose.yml. The key below is Azurite's published development key, not a secret.
RS_OBJECT_STORE=azure_blob
RS_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# RS_AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
RS_AZURE_BLOB_CONTAINER_EXPORTS=exports
RS_AZURE_BLOB_CONTAINER_SOURCES=sources

# Directory holding schemas/*.schema.json (defaults to the repo's schemas/)
# RS_SCHEMA_DIR=

# LLM gateway (S1). Default model when a prompt's front matter sets none.
RS_LLM_MODEL=
# live: call the provider | record: call it and save cassettes | replay: answer from cassettes only (tests, CI)
RS_LLM_MODE=replay
# Exports (M9). Azure Boards process: agile (User Story) or scrum (Product Backlog Item); the tracker ticked by default.
RS_ADO_PROCESS=agile
RS_DEFAULT_TRACKER=jira
# With RS_OBJECT_STORE=fs, export zips are kept here
RS_EXPORT_DIR=var/exports
# Cassettes (default tests/cassettes) and prompt files (default prompts/)
# RS_LLM_CASSETTE_DIR=
# RS_PROMPT_DIR=
