# Requirements Studio configuration. Copy to .env for local development. Every setting is RS_*.
# Values below match docker-compose.yml and are for local development only.

# dev | test | prod. The dev OIDC stub (/dev/oidc) is mounted only when RS_ENV=dev and RS_OIDC_ISSUER is empty.
RS_ENV=dev

# Postgres 16 + pgvector (async driver)
RS_DATABASE_URL=postgresql+asyncpg://rs:rs@localhost:5432/rs

# Redis: arq job queue and the event stream
RS_REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage (MinIO locally) for sources and export packages
RS_S3_ENDPOINT=http://localhost:9000
RS_S3_ACCESS_KEY=rs-minio
RS_S3_SECRET_KEY=rs-minio-secret
RS_S3_BUCKET_SOURCES=rs-sources
RS_S3_BUCKET_EXPORTS=rs-exports

# OIDC. Empty issuer in dev = use the built-in stub. In prod, set to the Entra ID issuer, e.g.
# https://login.microsoftonline.com/<tenant-id>/v2.0
RS_OIDC_ISSUER=
RS_OIDC_AUDIENCE=requirements-studio
# Public base URL of the API (the dev stub's issuer is <this>/dev/oidc)
RS_PUBLIC_BASE_URL=http://localhost:8000

# Directory holding schemas/*.schema.json (defaults to the repo's schemas/)
# RS_SCHEMA_DIR=

# LLM gateway (P2). Default model when a prompt's front matter sets none.
RS_LLM_MODEL=
