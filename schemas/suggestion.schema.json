{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdo.internal/requirements-studio/schemas/suggestion/1.0",
  "title": "Improvement suggestion (M11)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suggestion_id",
    "idea_id",
    "kind",
    "target_refs",
    "title",
    "change_summary",
    "rationale",
    "evidence",
    "benefit",
    "controls",
    "confidence",
    "status",
    "ops"
  ],
  "properties": {
    "suggestion_id": {
      "type": "string",
      "pattern": "^S[0-9]{2}$"
    },
    "idea_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "automate_step",
        "automate_with_review",
        "add_human_queue",
        "deterministic_rule",
        "add_integration",
        "remove_step",
        "merge_steps",
        "add_sla"
      ]
    },
    "target_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "title": {
      "type": "string",
      "maxLength": 90
    },
    "change_summary": {
      "type": "string"
    },
    "rationale": {
      "type": "string",
      "description": "Why: the pain point or inefficiency, in the requester's terms."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "locator",
          "excerpt"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        }
      }
    },
    "benefit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minutes_saved_per_case": {
          "type": [
            "number",
            "null"
          ]
        },
        "cases_per_month": {
          "type": [
            "number",
            "null"
          ]
        },
        "hours_saved_per_month": {
          "type": [
            "number",
            "null"
          ]
        },
        "qualitative": {
          "type": "string"
        }
      }
    },
    "controls": {
      "type": "string",
      "description": "The human control kept or added (review, queue, approval). Every automation states one, even if 'none needed'."
    },
    "risk": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "edited"
      ]
    },
    "decision": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "ops": {
      "type": "array",
      "description": "JSON Patch applied to the to-be IR when accepted.",
      "items": {
        "type": "object",
        "required": [
          "op",
          "path"
        ]
      }
    }
  }
}
