<mxfile host="requirements-studio" type="device"><diagram id="proc_client_kyc_as_is" name="Process flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2200" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Client KYC checks — as-is (today) process flow (IR v19)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="2200" height="40" as="geometry"/></mxCell><mxCell id="lane_act_onboarding_analyst" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C8C8C8;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="2200" height="270" as="geometry"/></mxCell><mxCell id="lanehead_act_onboarding_analyst" value="Onboarding Analyst" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#C8C8C8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="70" width="140" height="270" as="geometry"/></mxCell><mxCell id="lane_act_engagement_manager" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C8C8C8;" vertex="1" parent="1"><mxGeometry x="0" y="340" width="2200" height="160" as="geometry"/></mxCell><mxCell id="lanehead_act_engagement_manager" value="Engagement Manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#C8C8C8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="340" width="140" height="160" as="geometry"/></mxCell><mxCell id="lane_act_mlro" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C8C8C8;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="2200" height="160" as="geometry"/></mxCell><mxCell id="lanehead_act_mlro" value="MLRO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#C8C8C8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="140" height="160" as="geometry"/></mxCell><mxCell id="node_analyst_review" value="&lt;b&gt;APPROVAL GATE&lt;/b&gt;&lt;br&gt;Analyst approval of medium-risk client&lt;br&gt;&lt;i&gt;Approver: Onboarding Analyst&lt;/i&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.12;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1565" y="210" width="170" height="80" as="geometry"/></mxCell><mxCell id="node_await_docs" value="&lt;b&gt;[WAIT]&lt;/b&gt;&lt;br&gt;Await client documents&lt;br&gt;&lt;i&gt;Due within 5 working days&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="108" width="160" height="64" as="geometry"/></mxCell><mxCell id="node_chase_docs" value="&lt;b&gt;[HUMAN]&lt;/b&gt;&lt;br&gt;Chase missing documents&lt;br&gt;&lt;i&gt;~30 min per case&lt;/i&gt;&lt;br&gt;&lt;i&gt;PAIN: Chasing by email&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="202" width="160" height="96" as="geometry"/></mxCell><mxCell id="node_decline" value="&lt;b&gt;[HUMAN]&lt;/b&gt;&lt;br&gt;Decline client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1770" y="378" width="160" height="64" as="geometry"/></mxCell><mxCell id="node_end_complete" value="KYC complete" style="ellipse;shape=doubleEllipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1818" y="108" width="64" height="64" as="geometry"/></mxCell><mxCell id="node_end_declined" value="Client declined" style="ellipse;shape=doubleEllipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2018" y="378" width="64" height="64" as="geometry"/></mxCell><mxCell id="node_mlro_approval" value="&lt;b&gt;APPROVAL GATE&lt;/b&gt;&lt;br&gt;MLRO approval of high-risk client&lt;br&gt;&lt;i&gt;Approver: MLRO&lt;/i&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.12;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1565" y="530" width="170" height="80" as="geometry"/></mxCell><mxCell id="node_record_kyc" value="&lt;b&gt;[HUMAN]&lt;/b&gt;&lt;br&gt;Record KYC outcome&lt;br&gt;&lt;i&gt;~15 min per case&lt;/i&gt;&lt;br&gt;&lt;i&gt;PAIN: Outcome typed into the CRM by hand&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1570" y="92" width="160" height="96" as="geometry"/></mxCell><mxCell id="node_request_docs" value="&lt;b&gt;[HUMAN]&lt;/b&gt;&lt;br&gt;Request KYC documents&lt;br&gt;&lt;i&gt;~10 min per case&lt;/i&gt;&lt;br&gt;&lt;i&gt;PAIN: ID documents gathered by email&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="92" width="160" height="96" as="geometry"/></mxCell><mxCell id="node_risk_level" value="Risk level?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1390" y="100" width="120" height="80" as="geometry"/></mxCell><mxCell id="node_risk_rate" value="&lt;b&gt;[HUMAN]&lt;/b&gt;&lt;br&gt;Assign risk rating&lt;br&gt;&lt;i&gt;~10 min per case&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1170" y="100" width="160" height="80" as="geometry"/></mxCell><mxCell id="node_screen" value="&lt;b&gt;[HUMAN]&lt;/b&gt;&lt;br&gt;Screen client and owners&lt;br&gt;&lt;i&gt;~25 min per case&lt;/i&gt;&lt;br&gt;&lt;i&gt;PAIN: Screening run separately from the other checks&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="92" width="160" height="96" as="geometry"/></mxCell><mxCell id="node_start" value="Client record created" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="110" width="60" height="60" as="geometry"/></mxCell><mxCell id="node_verify_id" value="&lt;b&gt;[HUMAN]&lt;/b&gt;&lt;br&gt;Verify identity documents&lt;br&gt;&lt;i&gt;~20 min per case&lt;/i&gt;&lt;br&gt;&lt;i&gt;PAIN: IDs checked by hand&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="92" width="160" height="96" as="geometry"/></mxCell><mxCell id="queue_exc_docs_overdue" value="&lt;b&gt;HUMAN QUEUE&lt;/b&gt;&lt;br&gt;No documents after 10 working days&lt;br&gt;&lt;i&gt;Engagement Manager&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="382" width="160" height="56" as="geometry"/></mxCell><mxCell id="edge_start_request" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_start" target="node_request_docs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_request_await" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_request_docs" target="node_await_docs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_await_verify" value="Documents received" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_await_docs" target="node_verify_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="route_sla_docs_due_node_await_docs" value="Overdue (SLA 5 working days)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#7F7F7F;fontColor=#7F7F7F;fontSize=10;" edge="1" parent="1" source="node_await_docs" target="node_chase_docs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_chase_await" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_chase_docs" target="node_await_docs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_verify_screen" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_verify_id" target="node_screen"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_screen_rate" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_screen" target="node_risk_rate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_rate_level" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_risk_rate" target="node_risk_level"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_risk_high" value="High" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_risk_level" target="node_mlro_approval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_risk_low" value="Low" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_risk_level" target="node_record_kyc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_risk_medium" value="Medium" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_risk_level" target="node_analyst_review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_analyst_escalate" value="Rejected: escalate to MLRO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B85450;fontColor=#B85450;fontSize=10;" edge="1" parent="1" source="node_analyst_review" target="node_mlro_approval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_analyst_record" value="Approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_analyst_review" target="node_record_kyc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_mlro_record" value="Approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_mlro_approval" target="node_record_kyc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_mlro_decline" value="Rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B85450;fontColor=#B85450;fontSize=10;" edge="1" parent="1" source="node_mlro_approval" target="node_decline"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_record_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_record_kyc" target="node_end_complete"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_decline_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="node_decline" target="node_end_declined"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge_queue_exc_docs_overdue" value="Exception" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#D79B00;fontColor=#B07800;fontSize=10;" edge="1" parent="1" source="node_await_docs" target="queue_exc_docs_overdue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;[AUTO] blue: automated, no person&lt;br&gt;[AUTO + HUMAN REVIEW] amber, thick border: AI does it, a named person checks before it takes effect&lt;br&gt;[HUMAN] white: a person does it&lt;br&gt;APPROVAL GATE red hexagon: named approver approves or rejects; red arrow = rejected path&lt;br&gt;HUMAN QUEUE amber dashed: exceptions handed to a person&lt;br&gt;Dashed grey arrow: exception or SLA route&lt;br&gt;To-be: &#x27;Changed by Sxx&#x27; = accepted AI improvement suggestion; as-is: minutes per case and PAIN = where time goes today" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8C8C8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="680" width="620" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
